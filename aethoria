# Aethoria — Web Deployment Foundation

This version treats `index.html` as the public web entry point. Players should eventually receive a URL; they should not run a batch file or open the source `index.html` directly.

## Local production test

```bash
npm install
npm run build
npm start
```

Then open `http://localhost:4173/`.

## Important

- `index.html` is the web entry and contains a visible loading fallback.
- Vite turns the source app into `dist/` during `npm run build`.
- `server.cjs` serves `dist/` and the WebSocket endpoint.
- The current landing screen is intentionally the first milestone. Real Google/email authentication should be connected to a real auth provider rather than simulated in the browser.
- The game should eventually be deployed behind HTTPS on a free/low-cost web host; a custom domain can be connected later without rebuilding the application.

const http = require('http');
const fs = require('fs');
const path = require('path');
const { WebSocketServer } = require('ws');

const PORT = Number(process.env.PORT || 4173);
const ROOT = __dirname;
const DIST = path.join(ROOT, 'dist');
const sessions = new Map();

function id() { return Math.random().toString(36).slice(2, 10).toUpperCase(); }
function snapshot(s) { return { players: s.players, messages: s.messages.slice(-30) }; }
function broadcast(s) {
  const data = JSON.stringify({ type: 'snapshot', snapshot: snapshot(s) });
  for (const ws of s.clients) if (ws.readyState === 1) ws.send(data);
}
function getOrCreateSession(sessionId) {
  if (!sessions.has(sessionId)) sessions.set(sessionId, { id: sessionId, players: {}, messages: [] , clients: new Set() });
  return sessions.get(sessionId);
}

const server = http.createServer((req, res) => {
  const url = new URL(req.url, `http://${req.headers.host || 'localhost'}`);
  if (url.pathname === '/api/health') {
    res.writeHead(200, {'content-type':'application/json'}); return res.end(JSON.stringify({ok:true, sessions:sessions.size}));
  }
  if (url.pathname === '/api/sessions' && req.method === 'POST') {
    let body=''; req.on('data', c => body += c); req.on('end', () => { let requested=''; try { requested=JSON.parse(body).id || ''; } catch {} const sid = /^[A-Z0-9]{8}$/.test(requested) ? requested : id(); getOrCreateSession(sid); res.writeHead(201, {'content-type':'application/json'}); res.end(JSON.stringify({ id:sid })); }); return;
  }
  if (url.pathname === '/api/sessions' && req.method === 'GET') {
    const list = [...sessions.values()].map(s => ({id:s.id, players:Object.keys(s.players).length}));
    res.writeHead(200, {'content-type':'application/json'}); return res.end(JSON.stringify(list));
  }
  // Production/static serving. Build with `npm run build` first.
  let file = url.pathname === '/' ? path.join(DIST, 'index.html') : path.join(DIST, url.pathname.replace(/^\//,''));
  if (!file.startsWith(DIST)) return res.writeHead(403).end();
  if (!fs.existsSync(file)) file = path.join(DIST, 'index.html');
  if (!fs.existsSync(file)) return res.writeHead(503).end('Run npm run build first.');
  const ext = path.extname(file);
  const types = {'.html':'text/html','.js':'text/javascript','.css':'text/css','.svg':'image/svg+xml','.png':'image/png','.jpg':'image/jpeg','.webp':'image/webp'};
  res.writeHead(200, {'content-type': types[ext] || 'application/octet-stream', 'cache-control': ext === '.html' ? 'no-cache' : 'public, max-age=31536000, immutable'});
  fs.createReadStream(file).pipe(res);
});

const wss = new WebSocketServer({ noServer:true });
server.on('upgrade', (req, socket, head) => {
  const url = new URL(req.url, `http://${req.headers.host || 'localhost'}`);
  if (url.pathname !== '/ws') return socket.destroy();
  const sessionId = url.searchParams.get('session');
  if (!sessionId) return socket.destroy();
  wss.handleUpgrade(req, socket, head, ws => { ws.sessionId = sessionId; wss.emit('connection', ws); });
});

wss.on('connection', ws => {
  const s = getOrCreateSession(ws.sessionId); s.clients.add(ws);
  ws.send(JSON.stringify({type:'snapshot', snapshot:snapshot(s)}));
  ws.on('message', raw => {
    try {
      const msg = JSON.parse(raw.toString());
      if (msg.type === 'join' && msg.player?.id) s.players[msg.player.id] = {...msg.player, lastSeen:Date.now()};
      if (msg.type === 'update' && msg.player?.id) s.players[msg.player.id] = {...msg.player, lastSeen:Date.now()};
      if (msg.type === 'leave' && msg.playerId) delete s.players[msg.playerId];
      if (msg.type === 'message' && msg.text) s.messages.push({id:Date.now().toString(36), text:String(msg.text), type:msg.messageType || 'info', timestamp:Date.now()});
      broadcast(s);
    } catch {}
  });
  ws.on('close', () => {
    s.clients.delete(ws);
    // Do not immediately delete a player: reconnects are allowed. Stale players are pruned below.
  });
});

setInterval(() => {
  const cutoff = Date.now() - 20000;
  for (const s of sessions.values()) {
    for (const [pid,p] of Object.entries(s.players)) if (p.lastSeen < cutoff) delete s.players[pid];
    broadcast(s);
  }
}, 5000);

server.listen(PORT, '0.0.0.0', () => console.log(`Aethoria server running on port ${PORT}`));

